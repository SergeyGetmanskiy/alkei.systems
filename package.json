{
  "name": "alkei-systems",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Корпоративный сайт Alkei.Systems (React + TypeScript + SCSS modules)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:render": "node scripts/check-render.mjs",
    "verify": "npm run typecheck && npm run check:i18n && npm run check:render && vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "sass": "^1.79.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
